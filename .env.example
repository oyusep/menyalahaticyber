# ============================================================
# OSINT Cyber Guardian - Konfigurasi API Key
# Salin file ini menjadi .env dan isi dengan key Anda
# ============================================================

# Google Custom Search JSON API
# Dapatkan di: https://developers.google.com/custom-search/v1/introduction
GOOGLE_API_KEY=your_google_custom_search_api_key_here

# Google Programmable Search Engine ID (CX)
# Dapatkan di: https://programmablesearchengine.google.com/
GOOGLE_CX=your_search_engine_cx_id_here

# HaveIBeenPwned API Key
# Dapatkan di: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=your_haveibeenpwned_api_key_here

# SerpAPI Key (Opsional - alternatif Google Search)
# Dapatkan di: https://serpapi.com/
SERP_API_KEY=your_serpapi_key_here_optional
